/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' https://us-assets.i.posthog.com; connect-src 'self' https://us.i.posthog.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# The installer for `curl -fsSL https://keysrs.com/install | bash`: plain text, so a
# browser shows it instead of saving it, and a short cache so a fix reaches people fast.
/install
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
