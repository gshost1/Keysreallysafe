{
  admin off
  servers {
    max_header_size 16KB
    timeouts {
      read_header 5s
      read_body 15s
      write 30s
      idle 30s
    }
  }
  log default {
    # Proxy errors can contain the peer IP, URI and headers even with access
    # logging disabled. Keep operational TLS/config logs, exclude HTTP requests.
    exclude http.log.access http.log.error
  }
}

{$ANALYTICS_DOMAIN} {
  # Access logging is intentionally absent. Do not add `log` for this route.
  @reports {
    method POST
    path /v1/reports
  }
  handle @reports {
    request_body {
      max_size 16KB
    }
    reverse_proxy collector:8787
  }

  @health {
    method GET
    path /healthz
  }
  handle @health {
    reverse_proxy collector:8787
  }

  respond 404
}
