  "fields": {
    "api": "usage parser: openai (chat-completions + responses), anthropic (messages), gemini (generateContent usageMetadata), other (no usage parsed); omitted means other",
    "auth_header": "header the gateway sets; omitted means Authorization",
    "auth_prefix": "string prepended to the secret in that header; omitted means \"Bearer \"",
    "path_prefix": "prepended to the client path after /<keyname>; omitted means none",
    "host": "omitted when the host is per account; the key row must carry it",
    "key_prefix": "secret prefix hint for the Add dialog, omitted if none",
    "gateway": "false when the vendor needs request signing or OAuth, so it cannot be proxied; omitted means true",
    "note": "shown when asking for a per-account host; omitted if none"
  },
