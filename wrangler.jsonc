{
  // The public site: static files from Site/, served by Cloudflare Workers
  // static assets (what Cloudflare Pages became). `wrangler deploy`.
  // Only /api/* runs Worker code (SiteWorker/src/worker.js, the notify form);
  // everything else is served straight from Site/ without invoking it.
  "$schema": "https://esm.sh/wrangler/config-schema.json",
  "name": "keysrs",
  "main": "SiteWorker/src/worker.js",
  "compatibility_date": "2026-09-21",
  "assets": { "directory": "Site", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "routes": [
    { "pattern": "keysrs.com", "custom_domain": true },
    { "pattern": "www.keysrs.com", "custom_domain": true }
  ],
  // Notify-me sign-ups: key "email:<address>", value {platform, day}.
  // PLACEHOLDER: replace with the id that `npx wrangler kv namespace create
  // NOTIFY` prints. A deploy with the placeholder fails rather than
  // writing anywhere.
  "kv_namespaces": [{ "binding": "NOTIFY", "id": "REPLACE_WITH_NOTIFY_KV_NAMESPACE_ID" }],
  // Five sign-up attempts per IP per minute, per Cloudflare location.
  "ratelimits": [{ "name": "NOTIFY_LIMIT", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } }],
  // Request bodies carry email addresses; keep them out of Workers Logs.
  "observability": { "enabled": false }
}
