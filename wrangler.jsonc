{
  // The public marketing site: static files from Site/, served by Cloudflare
  // Workers static assets (what Cloudflare Pages became). `wrangler deploy`.
  "$schema": "https://esm.sh/wrangler/config-schema.json",
  "name": "keysrs",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  // /license and the Stripe webhook are handled by the Worker; everything else is a file in Site/.
  "assets": { "directory": "Site", "binding": "ASSETS", "run_worker_first": ["/license", "/api/*"], "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "send_email": [{ "name": "EMAIL" }],
  "routes": [
    { "pattern": "keysrs.com", "custom_domain": true },
    { "pattern": "www.keysrs.com", "custom_domain": true }
  ],
  "observability": { "enabled": false }
}
