.build/
.swiftpm/

# Local databases and journals may contain vault metadata or usage history.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Never commit environment files, credentials, or signing material.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.mobileprovision

.DS_Store
*.xcuserstate
xcuserdata/
*.log
# The synthetic Droid home is fixture data, not a local log: its active log
# must track, or a fresh checkout (CI included) runs the ingest tests
# against a home that holds only the dated rotation.
!Fixtures/droid-home/logs/droid-log-single.log

# Playwright for the browser suites, installed by `npm ci` in scripts/tests.
scripts/tests/node_modules/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# tester-army browser reports contain synthetic screenshots and traces.
scripts/tests/.e2e/

# The relay Worker's pinned tooling, installed by `npm ci` in Relay.
Relay/node_modules/
